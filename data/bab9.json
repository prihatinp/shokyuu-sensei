  "bunpo": [
    {
      "pola": "Bentuk kamus (る) dan bentuk ない",
      "arti": "bentuk biasa dari 〜ます / 〜ません",
      "jelaskan": "Grup 1 (〜い ます): かきます → かく → かかない, あいます → あう → あわない. Grup 2 (〜え/い ます): たべます → たべる → たべない. Tidak beraturan: します → する → しない, きます → くる → こない. Khusus: あります → ある → ない.",
      "contoh": [["いく / いかない", "pergi / tidak pergi"], ["たべる / たべない", "makan / tidak makan"], ["する / しない", "melakukan / tidak melakukan"]]
    },
    {
      "pola": "(たぶん) V-る / V-ない + でしょう",
      "arti": "mungkin akan … / mungkin tidak …",
      "jelaskan": "でしょう menyatakan perkiraan. Setelah kata kerja pakai bentuk kamus/ない. Sifat-i langsung + でしょう. Sifat-な dan kata benda tanpa だ.",
      "contoh": [["あしたは たぶん 雨が ふるでしょう。", "Besok mungkin hujan."], ["その しごとは らくでは ないでしょう。", "Pekerjaan itu mungkin tidak ringan."]]
    },
    {
      "pola": "〜か どうか わかりません",
      "arti": "tidak tahu apakah … atau tidak",
      "jelaskan": "Bisa juga: 〜か 〜ないか. Pakai bentuk biasa (る/ない).",
      "contoh": [["あした しゅっちょうが あるか どうか、わかりません。", "Saya belum tahu besok ada dinas luar atau tidak."]]
    },
    {
      "pola": "Kalimat 1 が、Kalimat 2",
      "arti": "…, tetapi …",
      "jelaskan": "が di akhir kalimat pertama berarti 'tetapi'. Lebih halus dari しかし.",
      "contoh": [["この しごとは たいへんですが、おもしろいです。", "Pekerjaan ini berat, tapi menarik."]]
    },
    {
      "pola": "A は V-ますが、B は V-ません",
      "arti": "A sih …, tapi B tidak",
      "jelaskan": "は dipakai untuk membandingkan dua hal. Partikel lain ditambah は: へは, には.",
      "contoh": [["コーヒーは のみますが、おさけは のみません。", "Kopi minum, tapi alkohol tidak."], ["としょしつには ありませんが、じむしつには あります。", "Di perpustakaan tidak ada, tapi di kantor ada."]]
    },
    {
      "pola": "V-ませんか (pertanyaan negatif) — jawab はい / いいえ",
      "arti": "Apakah tidak …?",
      "jelaskan": "Jawaban Jepang mengikuti pernyataan: はい、いません = 'Betul, (dia) tidak ada'. いいえ、います = 'Tidak, (dia) ada'.",
      "contoh": [["ブディさんは いませんか。", "Budi tidak ada?"], ["はい、いません。", "Iya, tidak ada."]]
    },
    {
      "pola": "Tempat で N が あります",
      "arti": "di (tempat) ada (acara)",
      "jelaskan": "Untuk acara/kejadian, tempatnya memakai で (bukan に).",
      "contoh": [["あした こうじょうで かいぎが あります。", "Besok ada rapat di pabrik."]]
    },
    {
      "pola": "どこかへ / だれかに … — どこへも / だれにも + negatif",
      "arti": "ke suatu tempat / kepada seseorang — tidak ke mana pun / tidak kepada siapa pun",
      "jelaskan": "Partikel diselipkan sebelum も: どこへも, だれとも, だれにも, どこからも.",
      "contoh": [["やすみに どこかへ 行きますか。", "Libur pergi ke suatu tempat?"], ["いいえ、どこへも 行きません。", "Tidak, tidak ke mana-mana."]]
    },
    {
      "pola": "N1 は N2 が おおい / すくない です",
      "arti": "N1 banyak/sedikit N2-nya",
      "jelaskan": "おおい dan すくない biasanya jadi predikat, bukan langsung di depan kata benda.",
      "contoh": [["チカランは こうじょうが おおいです。", "Cikarang banyak pabriknya."]]
    }
