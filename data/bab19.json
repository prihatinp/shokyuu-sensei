  "bunpo": [
    {
      "pola": "V-た ことが あります",
      "arti": "pernah V",
      "jelaskan": "Pengalaman di masa lalu. Belum pernah: 〜た ことが ありません (sering dengan まだ / いちども).",
      "contoh": [["日本の こうじょうで はたらいた ことが あります。", "Saya pernah bekerja di pabrik Jepang."], ["まだ いちども ふじさんに のぼった ことが ありません。", "Belum pernah sekali pun mendaki Gunung Fuji."]]
    },
    {
      "pola": "V-る / V-ない ことが あります",
      "arti": "kadang-kadang (tidak) V",
      "jelaskan": "Bentuk kamus/ない + ことが ある = sesekali terjadi.",
      "contoh": [["ラインが とまる ことが あります。", "Kadang line berhenti."], ["あさごはんを たべない ことが あります。", "Kadang saya tidak sarapan."]]
    },
    {
      "pola": "Bentuk biasa + と、…",
      "arti": "kalau / setiap kali … (pasti) …",
      "jelaskan": "Akibat yang pasti atau alami. Kalimat kedua tidak boleh berupa permintaan atau ajakan. Sifat-な/N: 〜だと.",
      "contoh": [["この ボタンを おすと、きかいが とまります。", "Kalau tombol ini ditekan, mesin berhenti."], ["まっすぐ いくと、しんごうが あります。", "Kalau jalan lurus, ada lampu lalu lintas."]]
    },
    {
      "pola": "V1-ます(stem) + ながら、V2",
      "arti": "V2 sambil V1",
      "jelaskan": "Dua kegiatan bersamaan oleh orang yang sama. Kegiatan utama di belakang.",
      "contoh": [["メモを とりながら、せつめいを ききます。", "Mendengarkan penjelasan sambil mencatat."]]
    },
    {
      "pola": "Kata tanya が … — X が …",
      "arti": "yang mana / siapa yang … (penekanan)",
      "jelaskan": "Kata tanya sebagai subjek memakai が, jawabannya juga が.",
      "contoh": [["どれが あなたの かさですか。", "Payung Anda yang mana?"], ["これが わたしの です。", "Yang ini punya saya."]]
    },
    {
      "pola": "〜のは X です",
      "arti": "yang … adalah X (penekanan)",
      "jelaskan": "Bagian yang ingin ditekankan dipindah ke belakang. Kalimat + の を jadi kata benda.",
      "contoh": [["こしょうしたのは 三ばんの きかいです。", "Yang rusak adalah mesin nomor 3."], ["むずかしいのは ぶんぽうです。", "Yang sulit adalah tata bahasa."]]
    },
    {
      "pola": "〜のは 〜からです",
      "arti": "… itu karena …",
      "jelaskan": "Menjelaskan alasan dengan penekanan.",
      "contoh": [["きのう やすんだのは かぜを ひいたからです。", "Kemarin saya libur karena masuk angin."]]
    },
    {
      "pola": "V-ませんか",
      "arti": "maukah …? (ajakan halus)",
      "jelaskan": "Lebih sopan daripada 〜ましょう. Jawab: ええ、〜ましょう.",
      "contoh": [["いっしょに しょくじを しませんか。", "Mau makan bersama?"], ["いいですね。いきましょう。", "Boleh, ayo."]]
    },
    {
      "pola": "N が あります (orang)",
      "arti": "punya (saudara, istri, dll.)",
      "jelaskan": "Untuk hubungan keluarga, boleh memakai あります: あにが ふたり あります.",
      "contoh": [["わたしは こどもが ふたり あります。", "Saya punya dua anak."]]
    }
