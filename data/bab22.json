  "bunpo": [
    {
      "pola": "さしあげる / あげる / やる",
      "arti": "memberi (dari saya/pihak saya ke orang lain)",
      "jelaskan": "さしあげる ke atasan, あげる ke setara, やる ke adik/bawahan/hewan/tanaman. Penerima ditandai に.",
      "contoh": [["わたしは 先生に えはがきを さしあげました。", "Saya memberi guru kartu pos bergambar."], ["わたしは おとうとに Tシャツを やりました。", "Saya memberi adik kaos."]]
    },
    {
      "pola": "くださる / くれる",
      "arti": "(orang lain) memberi kepada saya",
      "jelaskan": "Penerimanya saya atau pihak saya. くださる bila pemberinya atasan.",
      "contoh": [["先生は わたしに 本を くださいました。", "Guru memberi saya buku."], ["ともだちが わたしに ゆびわを くれました。", "Teman memberi saya cincin."]]
    },
    {
      "pola": "いただく / もらう",
      "arti": "menerima dari …",
      "jelaskan": "Sumber ditandai に atau から. いただく bila dari atasan.",
      "contoh": [["わたしは 先生に 本を いただきました。", "Saya menerima buku dari guru."]]
    },
    {
      "pola": "V-て あげる / くれる / もらう (+ sopan: さしあげる, くださる, いただく)",
      "arti": "melakukan untuk / dilakukan oleh …",
      "jelaskan": "Memberi dan menerima jasa. 〜て くれる: orang berbuat baik untuk saya. 〜て もらう: saya minta/menerima bantuan. Hindari 〜て あげる langsung ke atasan.",
      "contoh": [["せんぱいが しごとを おしえて くれました。", "Senior mengajari saya pekerjaan."], ["ともだちに しゃしんを 見せて もらいました。", "Saya diperlihatkan foto oleh teman."]]
    },
    {
      "pola": "V-て いただけませんか / V-て いただきたいのですが",
      "arti": "bolehkah Anda …? (sangat sopan)",
      "jelaskan": "Permintaan yang lebih sopan daripada 〜て ください. Jawaban merendah: お + V-stem + しましょう.",
      "contoh": [["この しりょうを 見せて いただけませんか。— はい、お見せしましょう。", "Bolehkah saya lihat data ini? — Baik, akan saya tunjukkan."]]
    },
    {
      "pola": "V-て おきます / V-ないで おきます",
      "arti": "melakukan (tidak melakukan) lebih dulu sebagai persiapan",
      "jelaskan": "Tindakan persiapan atau membiarkan keadaan.",
      "contoh": [["かいぎの まえに しりょうを コピーして おきます。", "Sebelum rapat, saya fotokopi datanya dulu."], ["こんばん パーティーが あるから、ひるごはんは あまり たべないで おきます。", "Nanti malam ada pesta, jadi siang tidak makan banyak."]]
    },
    {
      "pola": "N が V(transitif)-て あります",
      "arti": "N sudah di-… (sengaja)",
      "jelaskan": "Keadaan hasil tindakan seseorang yang disengaja. Bandingkan V(intransitif)-て いる = keadaan alami: とが あいて いる vs とが あけて ある.",
      "contoh": [["かべに かんじの ひょうが はって あります。", "Di dinding ditempel tabel kanji."], ["パーティーの りょうりが よういして あります。", "Masakan pesta sudah disiapkan."]]
    },
    {
      "pola": "V-る / V-ない ように、〜",
      "arti": "agar (tidak) …",
      "jelaskan": "Tujuan dengan kata kerja tak sengaja (わかる, まにあう, potensial) atau bentuk negatif.",
      "contoh": [["じゅぎょうに まにあうように、はしって 行きました。", "Saya berlari agar keburu kelas."], ["けがを しないように、きを つけて ください。", "Hati-hati agar tidak cedera."]]
    },
    {
      "pola": "ざんねんながら",
      "arti": "sayangnya",
      "jelaskan": "Ungkapan tetap di depan kalimat berita kurang baik.",
      "contoh": [["ざんねんながら、きょうは まにあいませんでした。", "Sayangnya hari ini tidak keburu."]]
    }
  ],
