  "bunpo": [
    {
      "pola": "Kendaraan に のります / Kendaraan を おります",
      "arti": "naik / turun (kendaraan)",
      "jelaskan": "Perhatikan partikelnya: のる memakai に, おりる dan でる memakai を. Pindah kendaraan: A から B に のりかえます.",
      "contoh": [["チカラン駅で 電車に のります。", "Saya naik kereta di stasiun Cikarang."], ["つぎの 駅で 電車を おります。", "Saya turun di stasiun berikutnya."], ["バスから 電車に のりかえます。", "Pindah dari bus ke kereta."]]
    },
    {
      "pola": "Tempat を でます / Tempat に つきます・はいります",
      "arti": "keluar dari / tiba di / masuk ke (tempat)",
      "jelaskan": "でる = を (titik yang ditinggalkan). つく dan はいる = に (titik tujuan).",
      "contoh": [["七時に 家を でます。", "Jam 7 keluar dari rumah."], ["八時に こうじょうに つきます。", "Jam 8 tiba di pabrik."]]
    },
    {
      "pola": "V1-て、V2-て、V3",
      "arti": "V1, lalu V2, lalu V3",
      "jelaskan": "Menyambung kegiatan berurutan dengan bentuk て. Waktu (lampau/sekarang) ditentukan oleh kata kerja terakhir.",
      "contoh": [["あさ おきて、かおを あらって、ごはんを たべます。", "Pagi bangun, cuci muka, lalu makan."]]
    },
    {
      "pola": "V-て から、…",
      "arti": "setelah V, …",
      "jelaskan": "Menekankan bahwa kegiatan kedua dilakukan sesudah yang pertama selesai.",
      "contoh": [["しごとが おわって から、ジムへ いきます。", "Setelah kerja selesai, saya ke gym."]]
    },
    {
      "pola": "V-る まえに / N の まえに、…",
      "arti": "sebelum V / sebelum N, …",
      "jelaskan": "Kata kerja di depan まえに selalu bentuk kamus, walaupun ceritanya lampau.",
      "contoh": [["ねる まえに、メールを チェックします。", "Sebelum tidur, saya cek email."], ["かいぎの まえに、しりょうを よみます。", "Sebelum rapat, saya baca dokumen."]]
    },
    {
      "pola": "V-て います (sedang)",
      "arti": "sedang V",
      "jelaskan": "Kegiatan yang sedang berlangsung.",
      "contoh": [["いま ロボットが うごいて います。", "Robotnya sedang bergerak."], ["雨が ふって います。", "Sedang hujan."]]
    },
    {
      "pola": "V-て います (keadaan)",
      "arti": "keadaan tetap / kebiasaan",
      "jelaskan": "すんで います (tinggal di), はたらいて います (bekerja di). Juga untuk keadaan yang berlanjut.",
      "contoh": [["わたしは ブカシに すんで います。", "Saya tinggal di Bekasi."], ["じどうしゃの 会社で はたらいて います。", "Saya bekerja di perusahaan otomotif."]]
    },
    {
      "pola": "N を もって いきます / きます / かえります",
      "arti": "membawa N pergi / ke sini / pulang",
      "jelaskan": "Bentuk て + いく/くる menunjukkan arah gerakan.",
      "contoh": [["あした ノートパソコンを もって きて ください。", "Besok tolong bawa laptop."]]
    },
    {
      "pola": "Sifat-い → 〜さ (kata benda ukuran)",
      "arti": "ketinggian, panjang, berat, …",
      "jelaskan": "Buang い, ganti さ: たかい → たかさ, ながい → ながさ, おもい → おもさ.",
      "contoh": [["この ロボットの おもさは 五十キロぐらいです。", "Berat robot ini sekitar 50 kg."], ["ベルトコンベヤーの ながさは 十メートルです。", "Panjang konveyor 10 meter."]]
    },
    {
      "pola": "N へは どう いきますか",
      "arti": "Ke N bagaimana caranya?",
      "jelaskan": "どう untuk menanyakan cara/rute. Jawab dengan rangkaian 〜て.",
      "contoh": [["こうじょうへは どう いきますか。", "Ke pabrik bagaimana caranya?"], ["電車に のって、チカラン駅で おりて、タクシーで いきます。", "Naik kereta, turun di Cikarang, lalu naik taksi."]]
    }
  ],
