  "bunpo": [
    {
      "pola": "Bentuk kausatif V-せる / V-させる",
      "arti": "menyuruh / membiarkan …",
      "jelaskan": "Gol.1 u→a + せる (いく→いかせる, よむ→よませる). Gol.2 る→させる (たべさせる). する→させる, くる→こさせる. V intransitif: orang yang disuruh ditandai を. V transitif: ditandai に.",
      "contoh": [["ははは おとうとを びょういんへ 行かせました。", "Ibu menyuruh adik pergi ke rumah sakit."], ["かちょうは わたしに しりょうを コピーさせました。", "Kepala seksi menyuruh saya memfotokopi data."]]
    },
    {
      "pola": "Kausatif izin: 〜に すきな ように V-させる",
      "arti": "membiarkan / mengizinkan …",
      "jelaskan": "Kausatif juga berarti memberi kebebasan.",
      "contoh": [["りょうしんは こどもたちに じゆうに せんこうを えらばせました。", "Orang tua membiarkan anak-anak bebas memilih jurusan."]]
    },
    {
      "pola": "Kausatif emosi: 〜を わらわせる / びっくりさせる / おこらせる",
      "arti": "membuat (orang) tertawa / kaget / marah",
      "jelaskan": "Untuk perasaan, orang yang terkena ditandai を.",
      "contoh": [["たなかさんは じょうだんを 言って、みんなを わらわせました。", "Tanaka melucu dan membuat semua orang tertawa."]]
    },
    {
      "pola": "V-させて ください / V-させて いただけませんか",
      "arti": "izinkan saya …",
      "jelaskan": "Meminta izin untuk diri sendiri. Melaporkan izin: 〜させて くださいました / くれました.",
      "contoh": [["あしたは やすませて いただけませんか。", "Bolehkah saya izin libur besok?"], ["この でんわを つかわせて ください。", "Izinkan saya memakai telepon ini."]]
    },
    {
      "pola": "Bentuk biasa + はずです",
      "arti": "seharusnya / semestinya …",
      "jelaskan": "Keyakinan berdasar alasan logis. Sifat-な: ひつような はず, N: やすみの はず.",
      "contoh": [["きょうは 日ようびだから、ぎんこうは やすみの はずです。", "Hari ini Minggu, jadi bank semestinya libur."], ["さっき おんどを あげたから、あたたかい はずです。", "Suhunya tadi dinaikkan, jadi seharusnya hangat."]]
    },
    {
      "pola": "N (+partikel) なら",
      "arti": "kalau (yang) …, (maka)",
      "jelaskan": "Menyoroti satu pilihan sebagai kontras dengan yang lain.",
      "contoh": [["土ようびは だめですが、日ようびなら つごうが いいです。", "Sabtu tidak bisa, tapi kalau Minggu bisa."], ["こうじょうの 中では だめですが、外でなら いいです。", "Di dalam pabrik tidak boleh, tapi di luar boleh."]]
    },
    {
      "pola": "V-る / V-た / N の とおりに",
      "arti": "sesuai dengan …",
      "jelaskan": "Melakukan persis seperti contoh atau instruksi.",
      "contoh": [["わたしが やる とおりに、やって ください。", "Lakukan persis seperti yang saya lakukan."], ["マニュアルの とおりに、きかいを うごかします。", "Menjalankan mesin sesuai manual."]]
    },
    {
      "pola": "〜ばあいは",
      "arti": "apabila / dalam hal …",
      "jelaskan": "Kondisi tertentu (sering untuk prosedur). V-る/V-た/Sifat-い/Sifat-な な/N の + ばあい.",
      "contoh": [["じこが あった ばあいは、すぐ げんいんを しらべなければ なりません。", "Apabila terjadi kecelakaan, penyebab harus segera diselidiki."], ["けっせきの ばあいは、はやく れんらくして ください。", "Kalau absen, segera hubungi."]]
    },
    {
      "pola": "〜ほうです",
      "arti": "termasuk …",
      "jelaskan": "Menggolongkan secara umum: せが たかい ほう (termasuk tinggi), じょうずな ほう.",
      "contoh": [["アリさんは クラスの 中で せが たかい ほうです。", "Ali termasuk tinggi di kelas."]]
    },
    {
      "pola": "N1 の N2 (aposisi) / 〜ぶんの〜 / 〜ばい",
      "arti": "N2 yaitu N1 / pecahan / kelipatan",
      "jelaskan": "ともだちの なかむらさん = teman saya, Nakamura. 三ぶんの一 = sepertiga. 二ばい = dua kali lipat.",
      "contoh": [["こちらは ともだちの なかむらさんです。", "Ini teman saya, Nakamura."], ["せいさんりょうが 二ばいに なりました。", "Volume produksi menjadi dua kali lipat."]]
    }
  ],
