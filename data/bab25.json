  "bunpo": [
    {
      "pola": "Bentuk biasa + ようです",
      "arti": "sepertinya …",
      "jelaskan": "Dugaan berdasar apa yang dilihat/didengar. Sifat-な: きらいなようです, N: るすのようです. Sering dengan どうも.",
      "contoh": [["どうも かぜを ひいて しまった ようです。", "Sepertinya saya masuk angin."], ["この きかいは どうも ふるい ようです。あまり うごきません。", "Mesin ini sepertinya sudah tua. Kurang jalan."]]
    },
    {
      "pola": "N ばかり / V-て ばかり いる",
      "arti": "melulu / hanya … saja",
      "jelaskan": "Menekankan sesuatu yang terlalu sering, biasanya bernada kritik.",
      "contoh": [["まいにち あめばかり ふって います。", "Setiap hari hujan melulu."], ["おとうとは べんきょうせずに、あそんで ばかり います。", "Adik tidak belajar, main melulu."]]
    },
    {
      "pola": "V-る / V-て いる / V-た ところです",
      "arti": "baru akan / sedang / baru saja …",
      "jelaskan": "Menunjukkan tahap kegiatan: sebelum mulai, di tengah, tepat setelah selesai.",
      "contoh": [["これから しょくじを する ところです。", "Baru mau makan."], ["ちょうど しごとが おわった ところです。", "Pekerjaan baru saja selesai."]]
    },
    {
      "pola": "Sifat(−い/−な) + がる / V-たがる",
      "arti": "(orang lain) merasa … / ingin …",
      "jelaskan": "Perasaan atau keinginan orang ketiga yang terlihat dari luar. Bentuk berlangsung: 〜がって いる. ほしい→ほしがる.",
      "contoh": [["あには がいこくへ 行きたがって います。", "Kakak ingin sekali ke luar negeri."], ["タンさんは さびしがって います。", "Tan merasa kesepian."]]
    },
    {
      "pola": "〜のに / それなのに",
      "arti": "padahal …",
      "jelaskan": "Hasil berlawanan dengan harapan, ada nada kecewa. Sifat-な/N: ひまなのに.",
      "contoh": [["よく べんきょうしたのに、せいせきが あがりませんでした。", "Padahal sudah rajin belajar, nilai tidak naik."], ["あの ひとは ひまなのに、てつだって くれません。", "Padahal dia senggang, tidak mau membantu."]]
    },
    {
      "pola": "V-て きました / V-て いきます",
      "arti": "(berubah) sampai sekarang / ke depan",
      "jelaskan": "〜て くる: perubahan dari dulu hingga sekarang, atau mulai terasa (ふって きた). 〜て いく: perubahan berlanjut ke depan.",
      "contoh": [["ぎじゅつは ずいぶん すすんで きました。", "Teknologi sudah maju pesat."], ["これからも どんどん しんぽして いくでしょう。", "Ke depan akan terus berkembang."], ["あめが ふって きました。", "Hujan mulai turun."]]
    },
    {
      "pola": "V-stem + はじめる",
      "arti": "mulai …",
      "jelaskan": "ふりはじめる (mulai turun), よみはじめる (mulai membaca).",
      "contoh": [["ちょうど ゆきが ふりはじめた ところです。", "Salju baru saja mulai turun."]]
    }
  ],
