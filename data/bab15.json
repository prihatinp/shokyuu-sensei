  "bunpo": [
    {
      "pola": "V-なければ なりません",
      "arti": "harus V",
      "jelaskan": "Bentuk ない: buang い, tambah ければ なりません. いく → いかない → いかなければ なりません. Sifat: あかるく なければ, ていねいで なければ.",
      "contoh": [["こうじょうでは あんぜんぐつを はかなければ なりません。", "Di pabrik harus memakai sepatu safety."], ["あした までに レポートを 出さなければ なりません。", "Harus menyerahkan laporan paling lambat besok."]]
    },
    {
      "pola": "V-なくても いいです / かまいません",
      "arti": "tidak perlu V",
      "jelaskan": "Bentuk ない: buang い, tambah くても いいです. Jawaban untuk 〜なければ なりませんか.",
      "contoh": [["スーツを きなければ なりませんか。", "Harus pakai jas?"], ["いいえ、きなくても いいです。", "Tidak, tidak perlu."]]
    },
    {
      "pola": "〜ても 〜なくても (どちらでも) いいです",
      "arti": "… atau tidak, dua-duanya boleh",
      "jelaskan": "Menyatakan bebas memilih.",
      "contoh": [["かいぎに でても でなくても いいです。", "Ikut rapat atau tidak, terserah."]]
    },
    {
      "pola": "V-る とき / V-た とき",
      "arti": "ketika (akan) V / ketika (sudah) V",
      "jelaskan": "V-る とき: kegiatan utama terjadi sebelum/saat V. V-た とき: setelah V terjadi.",
      "contoh": [["日本へ いく とき、くうこうで おみやげを かいました。", "Waktu akan ke Jepang, saya beli oleh-oleh di bandara."], ["日本へ いった とき、こうじょうを 見学しました。", "Waktu (sudah sampai) di Jepang, saya studi banding ke pabrik."]]
    },
    {
      "pola": "Sifat-い → 〜く します / Sifat-な・N → 〜に します",
      "arti": "membuat menjadi …",
      "jelaskan": "Bandingkan dengan なります (menjadi dengan sendirinya). します = sengaja diubah oleh seseorang.",
      "contoh": [["ラジオの おとを ちいさく して ください。", "Tolong kecilkan suara radio."], ["こうじょうを もっと あんぜんに しなければ なりません。", "Pabrik harus dibuat lebih aman."]]
    },
    {
      "pola": "N しか + negatif",
      "arti": "hanya N (dan dirasa kurang)",
      "jelaskan": "しか selalu diikuti bentuk negatif. Menggantikan が/を; partikel lain tetap: にしか, としか.",
      "contoh": [["ゆうべは 三じかんしか ねませんでした。", "Semalam cuma tidur 3 jam."], ["この ぶひんは 日本にしか ありません。", "Komponen ini hanya ada di Jepang."]]
    },
    {
      "pola": "Angka + も",
      "arti": "sampai sebanyak … (terasa banyak)",
      "jelaskan": "Kebalikan dari しか. Menekankan jumlahnya banyak.",
      "contoh": [["きのう 十二じかんも はたらきました。", "Kemarin kerja sampai 12 jam."]]
    },
    {
      "pola": "V-て から どのぐらい たちましたか",
      "arti": "sudah berapa lama sejak V?",
      "jelaskan": "たつ = waktu berlalu.",
      "contoh": [["この 会社に はいって から、どのぐらい たちましたか。", "Sudah berapa lama sejak masuk perusahaan ini?"], ["もう 二十年 たちました。", "Sudah 20 tahun."]]
    },
    {
      "pola": "まだ V-て いません",
      "arti": "belum V",
      "jelaskan": "Bentuk yang lebih natural untuk 'belum': まだ + 〜て いません.",
      "contoh": [["メールは もう おくりましたか。", "Email sudah dikirim?"], ["いいえ、まだ おくって いません。", "Belum."]]
    },
    {
      "pola": "V-て います (kebiasaan berulang)",
      "arti": "rutin melakukan V",
