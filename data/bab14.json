  "bunpo": [
    {
      "pola": "V-ます(stem) + たいです",
      "arti": "ingin V",
      "jelaskan": "Buang ます, tambah たい. Objeknya boleh を atau が. Untuk keinginan orang lain: 〜たいと いって います.",
      "contoh": [["日本の こうじょうを 見学したいです。", "Saya ingin studi banding ke pabrik Jepang."], ["あたらしい カメラが かいたいです。", "Saya ingin membeli kamera baru."]]
    },
    {
      "pola": "N が ほしいです",
      "arti": "ingin (memiliki) N",
      "jelaskan": "ほしい adalah sifat-i untuk benda yang diinginkan. Objeknya selalu が.",
      "contoh": [["はやい パソコンが ほしいです。", "Saya ingin komputer yang cepat."], ["じゆうな じかんが ほしいです。", "Saya ingin waktu luang."]]
    },
    {
      "pola": "N が すき / きらい / じょうず / へた です",
      "arti": "suka / tidak suka / pandai / tidak pandai N",
      "jelaskan": "Hal yang disukai atau dikuasai ditandai が (bukan を). Untuk diri sendiri, lebih rendah hati bilang とくい daripada じょうず.",
      "contoh": [["わたしは ロボットが 大好きです。", "Saya sangat suka robot."], ["ブディさんは 日本語が じょうずです。", "Budi pandai bahasa Jepang."]]
    },
    {
      "pola": "N の 中で X が いちばん 〜です",
      "arti": "di antara N, X yang paling …",
      "jelaskan": "Membandingkan dalam satu kelompok.",
      "contoh": [["くだものの 中で マンゴーが いちばん すきです。", "Di antara buah, saya paling suka mangga."]]
    },
    {
      "pola": "V-る こと",
      "arti": "kegiatan V (menjadikan kata kerja sebagai kata benda)",
      "jelaskan": "Bentuk kamus + こと = 'hal melakukan …'. Bisa jadi subjek atau objek.",
      "contoh": [["わたしの しゅみは きかいを つくる ことです。", "Hobi saya membuat mesin."], ["日本語で はなす ことは むずかしいです。", "Berbicara dalam bahasa Jepang itu sulit."]]
    },
    {
      "pola": "V-ても いいです / かまいません",
      "arti": "boleh V",
      "jelaskan": "Bentuk て + も いいです. Bertanya izin: 〜ても いいですか (lebih sopan: 〜ても いいでしょうか). Sifat: ちいさくても いい, 土ようびでも いい.",
      "contoh": [["ここで しゃしんを とっても いいですか。", "Boleh foto di sini?"], ["メモを とっても かまいません。", "Boleh mencatat."]]
    },
    {
      "pola": "V-ては いけません / だめです",
      "arti": "tidak boleh V",
      "jelaskan": "Larangan tegas (aturan). Lebih keras daripada 〜ないで ください.",
      "contoh": [["うごいて いる きかいに さわっては いけません。", "Tidak boleh menyentuh mesin yang sedang bergerak."], ["ここに ごみを すてては だめです。", "Tidak boleh buang sampah di sini."]]
    },
    {
      "pola": "V-ます(stem) + なさい",
      "arti": "V-lah! (perintah)",
      "jelaskan": "Perintah dari atasan ke bawahan, guru ke murid, orang tua ke anak. Jangan dipakai ke atasan.",
      "contoh": [["テキストの 十ページを 開けなさい。", "Buka buku halaman 10."]]
    },
    {
      "pola": "V-て みます",
      "arti": "mencoba V",
      "jelaskan": "Bentuk て + みる = melakukan sesuatu untuk melihat hasilnya.",
      "contoh": [["この ソフトを つかって みます。", "Saya coba pakai software ini."], ["いつか 日本へ いって みたいです。", "Suatu saat saya ingin mencoba ke Jepang."]]
    }
  ],
  "ungkapan": [
    ["あのう、これを つかっても いいでしょうか。— ええ、どうぞ。", "Minta izin dengan sopan"],
