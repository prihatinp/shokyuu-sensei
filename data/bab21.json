  "bunpo": [
    {
      "pola": "〜ば / 〜なければ",
      "arti": "jika … / jika tidak …",
      "jelaskan": "Bentuk syarat. Gol.1 u→eba (はなせば, かけば), Gol.2 る→れば (たべれば), すれば, くれば. Sifat-い: たかければ (いい→よければ). Sifat-な/N: あんぜんなら(ば). Negatif: 〜なければ.",
      "contoh": [["ゆっくり はなせば、わかります。", "Kalau bicara pelan, saya mengerti."], ["いい じょうけんなら、その かいしゃに つとめます。", "Kalau syaratnya bagus, saya bekerja di perusahaan itu."]]
    },
    {
      "pola": "〜ても / 〜なくても",
      "arti": "meskipun … / meskipun tidak …",
      "jelaskan": "Bentuk て + も. Sifat-い: いそがしくても. Sifat-な/N: らくでも, いい てんきでも. いく→いっても.",
      "contoh": [["いそがしくても、まいにち 日本語を べんきょうします。", "Meskipun sibuk, saya belajar bahasa Jepang setiap hari."], ["ざんぎょうしなくても、まにあいます。", "Meskipun tidak lembur, tetap keburu."]]
    },
    {
      "pola": "〜なら / それなら",
      "arti": "kalau (memang) begitu …",
      "jelaskan": "Menanggapi informasi dari lawan bicara lalu memberi saran atau pendapat.",
      "contoh": [["ほっかいどうへ 行くなら、ひこうきが べんりですよ。", "Kalau mau ke Hokkaido, pesawat praktis lho."], ["それなら、いっしょに えいがを 見に 行きましょう。", "Kalau begitu, ayo nonton film bersama."]]
    },
    {
      "pola": "V-たら、〜",
      "arti": "setelah / kalau sudah … (lalu)",
      "jelaskan": "Setelah kejadian pertama pasti terjadi, lakukan yang kedua. Bisa dengan permintaan atau ajakan.",
      "contoh": [["四時に なったら、わたしの ところへ 来て ください。", "Kalau sudah jam 4, datanglah ke tempat saya."], ["しごとが おわったら、すぐ れんらくします。", "Setelah kerja selesai, saya langsung kabari."]]
    },
    {
      "pola": "〜かもしれません",
      "arti": "mungkin …",
      "jelaskan": "Bentuk biasa + かもしれません. Sifat-な/N tanpa だ: ふじゅうぶんかもしれません.",
      "contoh": [["あしたは たいふうが 来るかもしれません。", "Besok mungkin topan datang."], ["この こたえは ただしく ないかもしれません。", "Jawaban ini mungkin tidak benar."]]
    },
    {
      "pola": "V-る のは 〜です",
      "arti": "melakukan V itu …",
      "jelaskan": "の mengubah kalimat menjadi kata benda sebagai subjek penilaian (たいへん, きけん, ざんねん).",
      "contoh": [["まいにち よしゅうを するのは たいへんです。", "Persiapan pelajaran setiap hari itu berat."], ["なみが たかい とき、うみで およぐのは きけんです。", "Berenang di laut saat ombak tinggi itu berbahaya."]]
    },
    {
      "pola": "〜のですが、どう したら / すれば いいですか",
      "arti": "…, sebaiknya bagaimana?",
      "jelaskan": "Meminta saran dengan sopan. Jawab: 〜たら いいでしょう / 〜て みて ください.",
      "contoh": [["いすが たりないのですが、どう したら いいでしょうか。", "Kursinya kurang, sebaiknya bagaimana?"], ["じむしつから かりたら いいでしょう。", "Sebaiknya pinjam dari kantor."]]
    }
  ],
