  "partikel": [
    {"soal": "屋上から ふじさん＿ みえます。", "jawab": "が", "arti": "Dari atap, Gunung Fuji terlihat."},
    {"soal": "オペレーターが きかい＿ とめました。", "jawab": "を", "arti": "Operator mematikan mesin."},
    {"soal": "きかい＿ とまりました。", "jawab": "が", "arti": "Mesinnya berhenti."},
    {"soal": "つぎの かど＿ 右へ まがって ください。", "jawab": "を", "arti": "Belok kanan di tikungan berikutnya."},
    {"soal": "もっと 大き＿ 書いて ください。", "jawab": "く", "arti": "Tolong tulis lebih besar."},
    {"soal": "しずか＿＿＿、よく ねむれます。", "jawab": "なので", "arti": "Karena tenang, bisa tidur nyenyak."},
    {"soal": "こげた におい＿ します。", "jawab": "が", "arti": "Tercium bau gosong."}
  ]
