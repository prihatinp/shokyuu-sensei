  "bunpo": [
    {
      "pola": "N が みえます / きこえます",
      "arti": "N terlihat / terdengar",
      "jelaskan": "Terlihat/terdengar dengan sendirinya, bukan sengaja melihat (みる) atau mendengar (きく). Objeknya が.",
      "contoh": [["こうじょうの 屋上から ふじさんが みえます。", "Dari atap pabrik Gunung Fuji terlihat."], ["きかいの へんな おとが きこえます。", "Terdengar suara aneh dari mesin."]]
    },
    {
      "pola": "N の においが / あじが / おとが します",
      "arti": "tercium bau … / terasa … / terdengar bunyi …",
      "jelaskan": "Persepsi indra memakai が します.",
      "contoh": [["こげた においが します。", "Tercium bau gosong."], ["この スープは へんな あじが します。", "Sup ini rasanya aneh."]]
    },
    {
      "pola": "Pasangan transitif ⇄ intransitif",
      "arti": "N を とめる ⇄ N が とまる",
      "jelaskan": "Transitif (ada pelaku, objek を): とめる, はじめる, おとす, つくる. Intransitif (terjadi sendiri, が): とまる, はじまる, おちる, できる.",
      "contoh": [["オペレーターが きかいを とめました。", "Operator mematikan mesin."], ["きかいが とまりました。", "Mesinnya berhenti."]]
    },
    {
      "pola": "V-て います (keadaan hasil)",
      "arti": "dalam keadaan …",
      "jelaskan": "Untuk kata kerja intransitif, 〜て います menunjukkan keadaan yang tersisa setelah perubahan.",
      "contoh": [["そらが はれて います。", "Langitnya cerah."], ["みちに さいふが おちて います。", "Ada dompet jatuh di jalan."]]
    },
    {
      "pola": "Tempat を V (gerak melewati)",
      "arti": "melewati / menyeberangi / menaiki …",
      "jelaskan": "Tempat yang dilalui gerakan memakai を: みちを わたる, かどを まがる, さかを のぼる, はしを とおる.",
      "contoh": [["つぎの かどを 右へ まがって ください。", "Belok kanan di tikungan berikutnya."], ["ほどうを あるいて ください。", "Silakan berjalan di trotoar."]]
    },
    {
      "pola": "V-て きます / V-て いきます",
      "arti": "… mendekat / … menjauh; … lalu kembali / … lalu pergi",
      "jelaskan": "Arah gerakan relatif ke pembicara. Juga: 〜を かって きます (beli lalu kembali).",
      "contoh": [["コンビニで のみものを かって きます。", "Saya beli minum di minimarket lalu kembali."], ["にもつを ここに おいて いきましょう。", "Ayo taruh barang di sini lalu pergi."]]
    },
    {
      "pola": "Sifat-い → 〜く V / Sifat-な → 〜に V",
      "arti": "kata keterangan cara",
      "jelaskan": "Kata sifat menerangkan kata kerja: はやい → はやく あるく, きれい → きれいに かく.",
      "contoh": [["もっと 大きく 書いて ください。", "Tolong tulis lebih besar."], ["ていねいに せつめいしました。", "Saya menjelaskan dengan teliti."]]
    },
    {
      "pola": "Kalimat 1 ので、Kalimat 2 / それで",
      "arti": "karena …, maka …",
      "jelaskan": "ので lebih halus dan objektif daripada から. Sifat-な dan kata benda: 〜なので. それで = karena itu (di awal kalimat).",
      "contoh": [["ぶひんが こなかったので、ラインが とまりました。", "Karena komponen tidak datang, line berhenti."], ["しずかなので、よく ねむれます。", "Karena tenang, bisa tidur nyenyak."]]
    },
    {
      "pola": "〜でしょう (↗ mencari persetujuan)",
      "arti": "…, kan? / bukan?",
      "jelaskan": "Diucapkan naik untuk meminta persetujuan lawan bicara.",
      "contoh": [["日本語は むずかしいでしょう。", "Bahasa Jepang sulit, kan?"]]
    }
  ],
  "ungkapan": [
    ["いって きます。— いって らっしゃい。", "Pamit pergi dan balasannya"],
    ["わあ、きれい！", "Ungkapan kagum"]
