  "bunpo": [
    {
      "pola": "V-る / V-ない つもりです",
      "arti": "berniat (tidak) V",
      "jelaskan": "Rencana yang sudah cukup pasti. Jawaban singkat: はい、その つもりです.",
      "contoh": [["らいねん 日本で はたらく つもりです。", "Tahun depan saya berniat bekerja di Jepang."], ["かいしゃは やめない つもりです。", "Saya tidak berniat keluar dari perusahaan."]]
    },
    {
      "pola": "V-(よ)う と おもって います",
      "arti": "sedang berpikir untuk V",
      "jelaskan": "Bentuk maksud (volitional): Gol.1 u→ou (かこう, はなそう), Gol.2 る→よう (たべよう), する→しよう, くる→こよう. Negatif: 〜(よ)うとは おもって いません.",
      "contoh": [["しかくの しけんを うけようと おもって います。", "Saya berpikir untuk ikut ujian sertifikasi."], ["つうやくに なろうとは おもって いません。", "Saya tidak berpikir untuk jadi penerjemah."]]
    },
    {
      "pola": "V-る ために / N の ために",
      "arti": "untuk / demi …",
      "jelaskan": "Menyatakan tujuan (subjek sama, kata kerja yang disengaja) atau manfaat bagi seseorang (だれの ために).",
      "contoh": [["日本語を べんきょうする ために、じしょを かいました。", "Untuk belajar bahasa Jepang, saya membeli kamus."], ["かぞくの ために、はたらいて います。", "Saya bekerja demi keluarga."]]
    },
    {
      "pola": "N を つかって V",
      "arti": "menggunakan N untuk V",
      "jelaskan": "Bentuk て menghubungkan cara/alat dengan tindakan utama.",
      "contoh": [["ドライバーを つかって ねじを しめて ください。", "Kencangkan sekrup memakai obeng."]]
    },
    {
      "pola": "V-ないで / V-ずに、V2",
      "arti": "V2 tanpa V",
      "jelaskan": "〜ずに lebih tertulis. Ubah ない→ず; する→せずに, くる→こずに.",
      "contoh": [["あさごはんを たべないで、かいしゃへ いきました。", "Berangkat kerja tanpa sarapan."], ["ゆうべは ねずに べんきょうしました。", "Semalam belajar tanpa tidur."]]
    },
    {
      "pola": "N1 のような N2 / N のように V・Adj",
      "arti": "N2 seperti N1 / seperti N",
      "jelaskan": "のような menerangkan kata benda, のように menerangkan kata kerja/sifat.",
      "contoh": [["きょうとのような ふるい まちに すみたいです。", "Ingin tinggal di kota tua seperti Kyoto."], ["せんぱいのように じょうずに 日本語を はなしたいです。", "Ingin bicara bahasa Jepang semahir senior."]]
    },
    {
      "pola": "N + ちゅう",
      "arti": "sedang …",
      "jelaskan": "しごとちゅう (sedang kerja), こうじちゅう (sedang dibangun), しようちゅう (sedang dipakai), うんてんちゅう (sedang menyetir).",
      "contoh": [["しようちゅうの きかいに さわらないで ください。", "Jangan sentuh mesin yang sedang dipakai."]]
    },
    {
      "pola": "Sifat-い く ありませんか",
      "arti": "bukankah …? / tidak … kah?",
      "jelaskan": "Pertanyaan negatif untuk menawarkan perhatian. Jawab ええ (ya, benar …) atau いいえ (tidak).",
      "contoh": [["さむく ありませんか。— ええ、ちょっと さむいです。", "Tidak dingin? — Iya, agak dingin."]]
    },
    {
      "pola": "こんな / そんな / あんな / どんな、このような …",
      "arti": "yang seperti ini / itu / mana",
      "jelaskan": "このような lebih formal daripada こんな.",
      "contoh": [["このような まちでは 車に きを つけなければ なりません。", "Di kota seperti ini harus hati-hati dengan mobil."]]
    }
  ],
  "ungkapan": [
