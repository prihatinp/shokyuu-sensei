  "bunpo": [
    {
      "pola": "Bentuk た (lampau biasa)",
      "arti": "versi santai dari 〜ました",
      "jelaskan": "Caranya sama persis dengan bentuk て, hanya て → た, で → だ: まって → まった, のんで → のんだ, かいて → かいた, たべて → たべた, して → した, きて → きた. Negatif lampau: 〜なかった.",
      "contoh": [["きのう えいがを みた。", "Kemarin nonton film."], ["あさごはんを たべなかった。", "Tidak sarapan."]]
    },
    {
      "pola": "Bentuk biasa: sifat dan kata benda",
      "arti": "だ・だった・ではない・ではなかった",
      "jelaskan": "Sifat-i: あつい / あつくない / あつかった / あつくなかった. Sifat-な dan kata benda: げんきだ / げんきではない / げんきだった / げんきではなかった.",
      "contoh": [["しごとは たいへんだった。", "Kerjaannya berat."], ["きのうは やすみではなかった。", "Kemarin bukan hari libur."]]
    },
    {
      "pola": "「…」と いいます",
      "arti": "berkata \"…\" (kutipan langsung)",
      "jelaskan": "Kalimat yang dikutip persis ditaruh dalam 「 」 lalu と.",
      "contoh": [["ぶちょうは「おつかれさま」と いいました。", "Kepala bagian berkata \"Otsukaresama\"."]]
    },
    {
      "pola": "Bentuk biasa + と いいました / ききました",
      "arti": "(dia) bilang bahwa … / dengar bahwa …",
      "jelaskan": "Kutipan tidak langsung. Isi kutipan pakai bentuk biasa. Kata benda dan sifat-な + だ.",
      "contoh": [["ブディさんは あした こないと いいました。", "Budi bilang besok tidak datang."], ["その ニュースは ほんとうだと ききました。", "Saya dengar berita itu benar."]]
    },
    {
      "pola": "Bentuk biasa + と おもいます",
      "arti": "saya pikir …",
      "jelaskan": "Menyampaikan pendapat. Untuk kata benda dan sifat-な pakai だ: だいじょうぶだと おもいます.",
      "contoh": [["この けいかくは いいと おもいます。", "Saya rasa rencana ini bagus."], ["ラインは もう だいじょうぶだと おもいます。", "Saya rasa line-nya sudah aman."]]
    },
    {
      "pola": "V1-たり、V2-たり します",
      "arti": "melakukan V1, V2, dan lain-lain",
      "jelaskan": "Menyebut beberapa contoh kegiatan, tidak berurutan. Juga untuk keadaan bolak-balik: ついたり きえたり (nyala-mati).",
      "contoh": [["やすみの 日は ほんを よんだり、さんぽを したり します。", "Hari libur saya membaca, jalan-jalan, dan lain-lain."], ["ランプが ついたり きえたり して います。", "Lampunya nyala-mati."]]
    },
    {
      "pola": "V-た あとで / N の あとで、…",
      "arti": "setelah V / setelah N, …",
      "jelaskan": "Kebalikan dari 〜まえに. Kata kerja selalu bentuk た.",
      "contoh": [["かいぎが おわった あとで、メールを おくります。", "Setelah rapat selesai, saya kirim email."], ["しょくじの あとで、くすりを のんで ください。", "Minum obat setelah makan."]]
    },
    {
      "pola": "Tempat に N を おきます / いれます / のせます / かけます",
      "arti": "meletakkan / memasukkan / menaruh di atas / menggantung N di (tempat)",
      "jelaskan": "Tempat tujuan benda diletakkan memakai に. Mengeluarkan memakai から: はこから だします.",
      "contoh": [["つくえの 上に しりょうを おきました。", "Saya taruh dokumen di atas meja."], ["はこから ぶひんを だして ください。", "Tolong keluarkan komponen dari kotak."]]
    },
    {
      "pola": "N に ついて",
      "arti": "tentang N",
      "jelaskan": "Menunjukkan topik pembicaraan atau tulisan.",
      "contoh": [["あたらしい ロボットに ついて せつめいします。", "Saya akan menjelaskan tentang robot baru."]]
    },
    {
      "pola": "N は なんと よみますか / Bahasa で なんと いいますか",
      "arti": "N dibaca apa? / dalam bahasa … disebut apa?",
      "jelaskan": "なんと = apa (untuk kutipan/bacaan). で menandai bahasa.",
      "contoh": [["この かんじは なんと よみますか。", "Kanji ini dibaca apa?"], ["「terima kasih」は 日本語で なんと いいますか。", "\"Terima kasih\" dalam bahasa Jepang apa?"]]
    }
  ],
