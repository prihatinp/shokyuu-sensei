  "bunpo": [
    {
      "pola": "Membuat bentuk て",
      "arti": "aturan perubahan kata kerja ke bentuk て",
      "jelaskan": "Grup 1: う・つ・る → って (あう→あって, まつ→まって, かえる→かえって); む・ぶ・ぬ → んで (やすむ→やすんで, よぶ→よんで); く → いて (かく→かいて); ぐ → いで (およぐ→およいで); す → して (はなす→はなして). Pengecualian: いく → いって. Grup 2: buang る + て (たべる→たべて). Tak beraturan: する→して, くる→きて.",
      "contoh": [["まつ → まって", "menunggu"], ["のむ → のんで", "minum"], ["かく → かいて", "menulis"], ["たべる → たべて", "makan"]]
    },
    {
      "pola": "V-て ください",
      "arti": "tolong V / silakan V",
      "jelaskan": "Meminta atau mempersilakan dengan sopan. Lebih halus dengan すみませんが、… di depan.",
      "contoh": [["すみませんが、ちょっと まって ください。", "Maaf, tolong tunggu sebentar."], ["どうぞ この いすを つかって ください。", "Silakan pakai kursi ini."]]
    },
    {
      "pola": "V-ないで ください",
      "arti": "tolong jangan V",
      "jelaskan": "Bentuk ない + で ください. Dipakai untuk larangan yang sopan.",
      "contoh": [["ここで たばこを すわないで ください。", "Tolong jangan merokok di sini."], ["きかいに さわらないで ください。", "Tolong jangan sentuh mesin."]]
    },
    {
      "pola": "Kalimat 1 から、Kalimat 2",
      "arti": "karena …, (maka) …",
      "jelaskan": "から di akhir kalimat pertama = alasan. Boleh pakai bentuk sopan (〜ますから) atau bentuk biasa.",
      "contoh": [["あぶないですから、ヘルメットを かぶって ください。", "Karena berbahaya, tolong pakai helm."]]
    },
    {
      "pola": "どうしてですか — 〜から です",
      "arti": "Mengapa? — Karena …",
      "jelaskan": "Jawaban alasan diakhiri から(です).",
      "contoh": [["どうして かいしゃを やすみましたか。", "Kenapa tidak masuk kantor?"], ["びょうきでしたから。", "Karena sakit."]]
    },
    {
      "pola": "Kalimat 1。だから、Kalimat 2",
      "arti": "… Oleh karena itu, …",
      "jelaskan": "だから di awal kalimat kedua. Arti sama dengan から, tapi kalimatnya dipisah.",
      "contoh": [["この きかいは ふるいです。だから、つかわないで ください。", "Mesin ini sudah tua. Karena itu jangan dipakai."]]
    },
    {
      "pola": "Tempat へ V-ます(stem) / N に いきます・きます・かえります",
      "arti": "pergi/datang/pulang untuk (tujuan)",
      "jelaskan": "Buang ます lalu tambah に: かいに いきます (pergi untuk membeli). Kata benda kegiatan: けんがくに いきます.",
      "contoh": [["ひこうじょうへ ともだちを むかえに いきます。", "Saya ke bandara untuk menjemput teman."], ["こうじょうへ けんがくに きました。", "Datang ke pabrik untuk kunjungan."]]
    },
    {
      "pola": "V-ます(stem) + かた",
      "arti": "cara V",
      "jelaskan": "Buang ます, tambah かた. つかいます → つかいかた (cara memakai). Objeknya memakai の: きかいの つかいかた.",
      "contoh": [["この ソフトの つかいかたを おしえて ください。", "Tolong ajari cara memakai software ini."]]
    },
    {
      "pola": "N を れんしゅうします = N の れんしゅうを します",
      "arti": "berlatih N",
      "jelaskan": "Kata benda kegiatan bisa dipakai dua cara: N を + 〜します atau N の + 〜を します.",
      "contoh": [["はつおんを れんしゅうします。", "Berlatih pelafalan."], ["はつおんの れんしゅうを します。", "Berlatih pelafalan."]]
    }
  ],
