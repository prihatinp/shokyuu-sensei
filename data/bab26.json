  "bunpo": [
    {
      "pola": "Bentuk biasa + そうです (kabar)",
      "arti": "katanya …",
      "jelaskan": "Menyampaikan informasi dari pihak lain. Sumber: 〜に よると / 〜の 話では. Beda dengan そう 'kelihatannya': di sini pakai bentuk biasa utuh (たかいそうです, しずかだそうです, がくせいだそうです).",
      "contoh": [["ニュースに よると、こうつうじこが ふえて きたそうです。", "Menurut berita, kecelakaan lalu lintas bertambah."], ["かちょうの 話では、あしたは ざんぎょうが ないそうです。", "Kata kepala seksi, besok tidak ada lembur."]]
    },
    {
      "pola": "V-る / V-ない ように (と) 言う・たのむ・ちゅういする・めいれいする",
      "arti": "menyuruh / meminta agar (tidak) …",
      "jelaskan": "Menyampaikan perintah atau permintaan secara tidak langsung.",
      "contoh": [["しゃちょうは しゃいんに きそくを まもるように 言いました。", "Direktur menyuruh karyawan menaati peraturan."], ["先生は がくせいに けっせきしないように ちゅういしました。", "Guru memperingatkan murid agar tidak absen."]]
    },
    {
      "pola": "Kata tanya + でも",
      "arti": "siapa pun / apa pun / kapan pun / di mana pun",
      "jelaskan": "だれでも, なんでも, いつでも, どの 〜でも, どこにでも. Kalimatnya positif.",
      "contoh": [["だれでも ほうりつを まもらなければ なりません。", "Siapa pun harus menaati hukum."], ["コンビニは どこにでも あります。", "Minimarket ada di mana-mana."]]
    },
    {
      "pola": "Bentuk biasa + だろうと おもいます",
      "arti": "saya kira mungkin …",
      "jelaskan": "Dugaan pribadi. Sifat-な/N tanpa だ sebelum だろう: たいへんだろう.",
      "contoh": [["らいねんは たぶん ぶっかが あがるだろうと おもいます。", "Saya kira tahun depan harga barang mungkin naik."]]
    },
    {
      "pola": "Waktu + までに",
      "arti": "paling lambat …",
      "jelaskan": "Batas waktu tindakan selesai. Bandingkan まで = terus-menerus sampai.",
      "contoh": [["金ようびまでに レポートを 出して ください。", "Serahkan laporan paling lambat Jumat."]]
    },
    {
      "pola": "〜あいだ / 〜あいだに",
      "arti": "selama … (terus) / selama … (sekali kejadian)",
      "jelaskan": "あいだ: kegiatan berlangsung sepanjang periode. あいだに: kejadian terjadi di dalam periode itu.",
      "contoh": [["はなしを きいて いる あいだ、とても ねむかったです。", "Selama mendengarkan, saya sangat mengantuk."], ["ひるやすみの あいだに、ぎんこうへ 行って きました。", "Selama istirahat siang, saya sempat ke bank."]]
    },
    {
      "pola": "V-る / N の とちゅうで",
      "arti": "di tengah jalan …",
      "jelaskan": "Sesuatu terjadi saat perjalanan atau kegiatan belum selesai.",
      "contoh": [["かいしゃへ 行く とちゅうで、じこに あいました。", "Di jalan ke kantor saya mengalami kecelakaan."]]
    },
    {
      "pola": "そんなに 〜ない",
