  "bunpo": [
    {
      "pola": "V-る ことが できます",
      "arti": "bisa V",
      "jelaskan": "Cara paling mudah menyatakan kemampuan atau kemungkinan. Kata benda kegiatan: N が できます (うんてんが できます).",
      "contoh": [["わたしは CAD を つかう ことが できます。", "Saya bisa memakai CAD."], ["日本語が すこし できます。", "Saya bisa sedikit bahasa Jepang."]]
    },
    {
      "pola": "Bentuk potensial (〜える / 〜られる)",
      "arti": "bisa V (bentuk ringkas)",
      "jelaskan": "Grup 1: ubah bunyi -u menjadi -eru (はなす → はなせる, かく → かける, よむ → よめる). Grup 2: る → られる (たべる → たべられる). くる → こられる, する → できる. Objeknya biasanya が.",
      "contoh": [["日本語が はなせます。", "Bisa berbicara bahasa Jepang."], ["さしみが たべられますか。", "Bisa makan sashimi?"]]
    },
    {
      "pola": "V-る ように なりました",
      "arti": "sekarang jadi bisa / jadi (terbiasa) V",
      "jelaskan": "Perubahan kemampuan atau kebiasaan dari waktu ke waktu. Sering dengan bentuk potensial.",
      "contoh": [["前は 日本語が ききとれませんでしたが、いまは ききとれる ように なりました。", "Dulu tidak bisa menangkap bahasa Jepang, sekarang sudah bisa."]]
    },
    {
      "pola": "(もし) 〜たら、…",
      "arti": "kalau / seandainya …",
      "jelaskan": "Bentuk た + ら. Negatif: 〜なかったら. Sifat-い: よかったら. Sifat-な/N: べんりだったら.",
      "contoh": [["あした 雨が ふったら、そとの しごとは しません。", "Kalau besok hujan, pekerjaan luar tidak dilakukan."], ["じかんが あったら、こうじょうを 見て ください。", "Kalau ada waktu, silakan lihat pabrik."]]
    },
    {
      "pola": "N に します",
      "arti": "memilih / memutuskan N",
      "jelaskan": "Dipakai saat memilih: 〜は 何に しますか。— 〜に します。",
      "contoh": [["のみものは 何に しますか。", "Minumnya apa?"], ["コーヒーに します。", "Saya pilih kopi."]]
    },
    {
      "pola": "V-る / V-ない ことに します",
      "arti": "memutuskan untuk (tidak) V",
      "jelaskan": "Keputusan dari diri sendiri.",
      "contoh": [["らいげつ 日本へ しゅっちょうする ことに しました。", "Saya memutuskan dinas ke Jepang bulan depan."], ["たばこを すわない ことに しました。", "Saya memutuskan berhenti merokok."]]
    },
    {
      "pola": "Angka + とも",
      "arti": "… semuanya (tanpa kecuali)",
      "jelaskan": "ふたりとも = dua-duanya, 五だいとも = kelima unitnya. Kedua hal: りょうほうとも.",
      "contoh": [["この ロボットは 三だいとも あたらしいです。", "Ketiga robot ini semuanya baru."]]
    },
    {
      "pola": "X と いうのは / X とは 〜の ことです",
      "arti": "yang disebut X adalah …",
      "jelaskan": "Untuk menjelaskan arti sebuah istilah.",
      "contoh": [["「かいぜん」と いうのは、しごとを よく する ことです。", "Yang disebut kaizen adalah memperbaiki pekerjaan."]]
    },
    {
      "pola": "N1 とか N2 とか",
      "arti": "N1, N2, dan sebagainya (lisan)",
      "jelaskan": "Mirip 〜や〜など, tapi lebih santai.",
      "contoh": [["しゅうまつは ゴルフとか テニスとか します。", "Akhir pekan saya main golf, tenis, dan sebagainya."]]
    },
    {
      "pola": "〜て くださいませんか",
      "arti": "maukah Anda … (permintaan sangat sopan)",
      "jelaskan": "Lebih halus dari 〜て ください. Cocok ke atasan atau tamu.",
      "contoh": [["この 書類に お名前を 書いて くださいませんか。", "Maukah Anda menulis nama di dokumen ini?"]]
    }
  ],
