  "bunpo": [
    {
      "pola": "Kalimat (bentuk biasa) + N",
      "arti": "N yang …",
      "jelaskan": "Kalimat diletakkan langsung di depan kata benda untuk menerangkannya, tanpa 'yang'. Kata kerjanya bentuk biasa (る, ない, た, ている).",
      "contoh": [["とけいを うって いる みせ", "toko yang menjual jam"], ["きのう かった パソコンは はやいです。", "Komputer yang kemarin saya beli cepat."], ["あそこに 立って いる 人は ぶちょうです。", "Orang yang berdiri di sana adalah kepala bagian."]]
    },
    {
      "pola": "Subjek が / の dalam kalimat penerang",
      "arti": "わたしが かいた え = わたしの かいた え",
      "jelaskan": "Subjek di dalam kalimat penerang memakai が (bukan は), dan boleh diganti の.",
      "contoh": [["これは わたしが せっけいした ジグです。", "Ini jig yang saya desain."], ["テレビの ある へや", "kamar yang ada TV-nya"]]
    },
    {
      "pola": "「X」と いう N",
      "arti": "N yang bernama X",
      "jelaskan": "Memperkenalkan nama sesuatu yang mungkin belum dikenal lawan bicara.",
      "contoh": [["ムサシと いう 会社に つとめて います。", "Saya bekerja di perusahaan bernama Musashi."], ["あれは 何と いう どうぶつですか。", "Itu hewan apa namanya?"]]
    },
    {
      "pola": "Kata tanya + 〜か、おしえて ください / しって います",
      "arti": "(tolong beri tahu) … apa/di mana/kapan …",
      "jelaskan": "Pertanyaan bisa masuk ke dalam kalimat dengan か di akhirnya. Kata kerjanya bentuk biasa.",
      "contoh": [["かいぎは 何時に はじまるか、おしえて ください。", "Tolong beri tahu rapat mulai jam berapa."], ["ぶひんが どこに あるか、しって いますか。", "Tahu komponennya ada di mana?"]]
    },
    {
      "pola": "しって います / しりません",
      "arti": "tahu / tidak tahu",
      "jelaskan": "Bentuk positif selalu しって います, tapi negatifnya しりません (bukan しって いません).",
      "contoh": [["その みせを しって いますか。", "Tahu toko itu?"], ["いいえ、しりません。", "Tidak, tidak tahu."]]
    },
    {
      "pola": "いって います / きて います / かえって います",
      "arti": "sedang berada di (tempat) setelah pergi/datang/pulang",
      "jelaskan": "Bukan 'sedang pergi', tapi hasilnya: sudah pergi dan sekarang ada di sana.",
      "contoh": [["ぶちょうは いま 日本に いって います。", "Kepala bagian sekarang sedang di Jepang."]]
    },
    {
      "pola": "Pakaian + きる / はく / かぶる / する / かける / しめる",
      "arti": "kata kerja 'memakai' sesuai jenis pakaian",
      "jelaskan": "きる: baju atasan, jaket. はく: celana, rok, sepatu, kaus kaki. かぶる: topi, helm. する: jam, cincin. かける: kacamata. しめる: dasi. Melepas: ぬぐ (umum), とる (topi, jam, kacamata).",
      "contoh": [["こうじょうでは ヘルメットを かぶって ください。", "Di pabrik tolong pakai helm."], ["あんぜんぐつを はいて います。", "Saya memakai sepatu safety."]]
    },
    {
      "pola": "なにか / だれか / どこか / いつか + kalimat penerang",
      "arti": "sesuatu / seseorang / suatu tempat / suatu saat yang …",
      "jelaskan": "Kata tanya + か = tidak tentu. Bisa langsung diikuti sifat atau kalimat.",
      "contoh": [["なにか いい アイデアは ありませんか。", "Ada ide bagus?"], ["いつか 日本の こうじょうを 見たいです。", "Suatu saat saya ingin melihat pabrik di Jepang."]]
    }
  ],
