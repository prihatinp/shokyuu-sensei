  "bunpo": [
    {
      "pola": "N は Sifat + N を して います",
      "arti": "N berwarna/berbentuk …",
      "jelaskan": "Untuk warna, bentuk, raut wajah: あかい いろを して いる, まるい かたちを して いる.",
      "contoh": [["もみじの はは あかい いろを して います。", "Daun maple berwarna merah."], ["この さらは まるい かたちを して います。", "Piring ini berbentuk bulat."]]
    },
    {
      "pola": "Sifat-い(−い) / Sifat-な + そうです",
      "arti": "kelihatannya …",
      "jelaskan": "Dugaan dari penampilan. おもい→おもそう, しんぱいな→しんぱいそう. Pengecualian: いい→よさそう, ない→なさそう. Sebagai penjelas: 〜そうな N, 〜そうに V.",
      "contoh": [["あの にもつは おもそうです。", "Barang itu kelihatannya berat."], ["がくせいたちは ねむそうに 話を きいて います。", "Para murid mendengarkan dengan wajah mengantuk."]]
    },
    {
      "pola": "V-ます(stem) + そうです / そうに なりました",
      "arti": "hampir / kelihatannya akan …",
      "jelaskan": "Tanda bahwa sesuatu akan segera terjadi. そうに なる = nyaris terjadi.",
      "contoh": [["うわぎの ボタンが とれそうです。", "Kancing jaket hampir copot."], ["かぜで 木が たおれそうに なりました。", "Pohon hampir roboh karena angin."]]
    },
    {
      "pola": "まるで N のようです / のように",
      "arti": "seakan-akan seperti N",
      "jelaskan": "まるで memperkuat perumpamaan.",
      "contoh": [["この パンは まるで いしのように かたいです。", "Roti ini keras seperti batu."]]
    },
    {
      "pola": "V-る / V-て いる のを 見る・聞く・待つ・手伝う",
      "arti": "melihat/mendengar … (kejadian)",
      "jelaskan": "の mengubah kalimat menjadi objek. Untuk みえる/きこえる memakai が: 〜のが みえます.",
      "contoh": [["ほしが ひかって いるのが みえます。", "Terlihat bintang bersinar."], ["かぞくから てがみが くるのを まって います。", "Menunggu surat datang dari keluarga."]]
    },
    {
      "pola": "V-る のに / N に + つかう・かかる・ひつよう",
      "arti": "untuk (keperluan) …",
      "jelaskan": "Menyatakan kegunaan, waktu, atau biaya yang dibutuhkan.",
      "contoh": [["この テープは ろくおんするのに つかいます。", "Pita ini dipakai untuk merekam."], ["よしゅうするのに 一じかん かかりました。", "Persiapan pelajaran makan waktu satu jam."]]
    },
    {
      "pola": "Bahan で / Bahan baku から つくる",
      "arti": "dibuat dari …",
      "jelaskan": "で bila bahannya masih terlihat (てつで かたな). から bila bahannya berubah wujud (ぎゅうにゅうから チーズ).",
      "contoh": [["ガラスで びんを つくります。", "Membuat botol dari kaca."], ["まめから しょうゆを つくります。", "Membuat kecap dari kacang."]]
    },
    {
      "pola": "V-た / V-て いる + N",
      "arti": "N yang (sedang/sudah) …",
      "jelaskan": "Keadaan sebagai penjelas kata benda. Dalam anak kalimat, を/は bisa berganti が: めがねを かけた ひと, くろい かばんを もった ひと.",
      "contoh": [["せいふくを きた けいさつかんが ならんで います。", "Polisi berseragam berbaris."], ["かわいた ぬので ガラスを みがいて ください。", "Gosok kaca dengan kain kering."]]
    },
    {
      "pola": "Angka + 以上・以下・以内・以前・以後",
      "arti": "… ke atas / ke bawah / dalam batas / sebelum / sesudah",
      "jelaskan": "Termasuk angka itu sendiri.",
      "contoh": [["さくぶんは 四百字以上 六百字以内で 書いて ください。", "Tulis karangan 400 sampai 600 huruf."], ["六十点以下の 学生は もう一度 テストを します。", "Murid dengan nilai 60 ke bawah tes ulang."]]
    }
  ],
  "ungkapan": [
    ["ばいてんへ おべんとうを かいに 行きませんか。— ええ、行きましょう。", "Mengajak membeli bekal"],
    ["あれに しましょう。", "Memutuskan pilihan"]
  ],
  "partikel": [
    {"soal": "この さらは まるい かたち＿ して います。", "jawab": "を", "arti": "Piring ini berbentuk bulat."},
    {"soal": "あの にもつは おも＿＿です。", "jawab": "そう", "arti": "Barang itu kelihatannya berat."},
    {"soal": "この パンは まるで いし＿ ように かたいです。", "jawab": "の", "arti": "Roti ini keras seperti batu."},
    {"soal": "ほしが ひかって いる＿＿ みえます。", "jawab": "のが", "arti": "Terlihat bintang bersinar."},
    {"soal": "よしゅうする＿＿ 一じかん かかりました。", "jawab": "のに", "arti": "Persiapan pelajaran makan satu jam."},
    {"soal": "まめ＿＿ しょうゆを つくります。", "jawab": "から", "arti": "Membuat kecap dari kacang."},
    {"soal": "ガラス＿ びんを つくります。", "jawab": "で", "arti": "Membuat botol dari kaca."}
  ]
}
