  "bunpo": [
    {
      "pola": "Bentuk pasif V-れる / V-られる",
      "arti": "di-…",
      "jelaskan": "Gol.1 u→a + れる (いう→いわれる, よむ→よまれる, かく→かかれる). Gol.2 る→られる (ほめられる). する→される, くる→こられる. Pelaku ditandai に.",
      "contoh": [["マナさんは 先生に しかられました。", "Mana dimarahi guru."], ["わたしは かちょうに ほめられました。", "Saya dipuji kepala seksi."]]
    },
    {
      "pola": "N1 は N2 に (N3 を) V-pasif",
      "arti": "N1 di-… oleh N2 (sesuatu miliknya)",
      "jelaskan": "Pasif kepunyaan: yang terkena adalah bagian tubuh atau barang milik N1.",
      "contoh": [["おとうとは あにに かおを なぐられました。", "Adik dipukul wajahnya oleh kakak."], ["ははは どろぼうに さいふを ぬすまれました。", "Ibu kecurian dompet oleh pencuri."]]
    },
    {
      "pola": "Pasif kerugian (V intransitif)",
      "arti": "terkena / kena akibat …",
      "jelaskan": "Kejadian yang merugikan pembicara: あめに ふられる (kehujanan), ちちに しなれる (ditinggal mati ayah).",
      "contoh": [["わたしたちは あめに ふられました。", "Kami kehujanan."]]
    },
    {
      "pola": "N が / は V-pasif (pelaku umum)",
      "arti": "… diselenggarakan / dibangun / diumumkan",
      "jelaskan": "Untuk acara, berita, bangunan, dll. ketika pelaku tidak penting.",
      "contoh": [["かいぎで あたらしい よていが はっぴょうされました。", "Di rapat diumumkan jadwal baru."], ["この せいひんは アジアの かくちに ゆしゅつされて います。", "Produk ini diekspor ke berbagai daerah di Asia."]]
    },
    {
      "pola": "V-て しまいます",
      "arti": "terlanjur / sampai habis …",
      "jelaskan": "Selesai tuntas, atau kejadian yang disesali. Lisan: 〜ちゃう.",
      "contoh": [["レポートを ぜんぶ 書いて しまいました。", "Laporan sudah selesai ditulis semua."], ["タクシーに わすれものを して しまいました。", "Saya terlanjur meninggalkan barang di taksi."]]
    },
    {
      "pola": "V-た まま / N の まま",
      "arti": "dalam keadaan masih …",
      "jelaskan": "Keadaan berlanjut tanpa berubah, sering tidak seharusnya.",
      "contoh": [["でんとうを つけた まま、ねました。", "Tidur dengan lampu masih menyala."], ["くつの まま、へやに はいらないで ください。", "Jangan masuk kamar dengan sepatu."]]
    },
    {
      "pola": "N で (sebab) / V-て, Sifat-くて, Sifat-なで (sebab perasaan)",
      "arti": "karena …",
      "jelaskan": "で untuk sebab kejadian (じこで, おおあめで). Bentuk て untuk sebab-akibat yang tak disengaja; kalimat kedua bukan perintah/ajakan.",
      "contoh": [["こうつうじこで けがを しました。", "Cedera karena kecelakaan lalu lintas."], ["あなたに あえて、うれしいです。", "Senang bisa bertemu Anda."]]
    },
    {
      "pola": "V-stem / Sifat(−い/−な) + すぎる",
      "arti": "terlalu …",
      "jelaskan": "のみすぎる, あつすぎる, ふくざつすぎる. Biasanya bermakna negatif.",
      "contoh": [["おさけを のみすぎて、あたまが いたく なりました。", "Terlalu banyak minum, kepala jadi sakit."], ["この ひもは みじかすぎて、つかえません。", "Tali ini terlalu pendek, tidak bisa dipakai."]]
    }
  ],
  "ungkapan": [
    ["あけまして おめでとう ございます。ことしも よろしく おねがいします。", "Salam tahun baru"],
    ["それは たいへんでしたね。", "Bersimpati atas kejadian buruk"]
