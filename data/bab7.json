    {
      "pola": "Sifat-い → 〜く なります",
      "arti": "menjadi (sifat)",
      "jelaskan": "Buang い, ganti く, lalu なります. さむい → さむく なります. Pengecualian: いい → よく なります.",
      "contoh": [["へやが あたたかく なりました。", "Ruangannya jadi hangat."], ["てんきが よく なりました。", "Cuacanya jadi bagus."]]
    },
    {
      "pola": "Sifat-な / N → 〜に なります",
      "arti": "menjadi (sifat-na / benda)",
      "jelaskan": "Kata sifat-na dan kata benda memakai に. しずか → しずかに なります. はたち → はたちに なります.",
      "contoh": [["こうじょうが しずかに なりました。", "Pabriknya jadi sepi."], ["ことし 五十さいに なりました。", "Tahun ini saya jadi 50 tahun."]]
    },
    {
      "pola": "Sifat-い → 〜くて、…",
      "arti": "(sifat 1) dan (sifat 2)",
      "jelaskan": "Menyambung dua kata sifat: buang い, ganti くて. いい → よくて.",
      "contoh": [["この パソコンは かるくて、はやいです。", "Komputer ini ringan dan cepat."]]
    },
    {
      "pola": "Sifat-な / N → 〜で、…",
      "arti": "(sifat-na) dan … / (N) dan …",
      "jelaskan": "Kata sifat-na dan kata benda memakai で untuk menyambung.",
      "contoh": [["この こうえんは しずかで、きれいです。", "Taman ini tenang dan indah."]]
    },
    {
      "pola": "もう V-ました / まだ V-ません",
      "arti": "sudah V / belum V",
      "jelaskan": "Jawab 'belum' dengan まだ + bentuk ません (bukan ませんでした).",
      "contoh": [["もう ひるごはんを たべましたか。", "Sudah makan siang?"], ["いいえ、まだ たべません。", "Belum."]]
    },
    {
      "pola": "N が ふります / ふきます / やみます",
      "arti": "hujan/salju turun · angin bertiup · berhenti",
      "jelaskan": "Fenomena alam memakai が. Hujan dan salju: ふります. Angin: ふきます. Berhenti: やみます.",
      "contoh": [["ごご 雨が ふりました。", "Siang tadi hujan turun."], ["かぜが やみました。", "Anginnya berhenti."]]
    },
    {
      "pola": "Pertanyaan だれが / なにが + V",
      "arti": "Siapa yang …? / Apa yang …?",
      "jelaskan": "Kalau kata tanya jadi subjek, pakai が (bukan は). Jawabannya juga memakai が.",
      "contoh": [["だれが きましたか。", "Siapa yang datang?"], ["ブディさんが きました。", "Budi yang datang."]]
    },
    {
      "pola": "こちら / そちら / あちら / どちら",
      "arti": "arah sini / situ / sana / mana (sopan)",
      "jelaskan": "Versi sopan dari ここ・そこ・あそこ・どこ, juga untuk arah.",
      "contoh": [["えきは どちらですか。", "Stasiun ke arah mana?"], ["あちらです。", "Ke arah sana."]]
    },
