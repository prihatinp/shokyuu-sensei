  "bunpo": [
    {
      "pola": "N1 は N2 が Sifat",
      "arti": "N1 itu N2-nya …",
      "jelaskan": "Menerangkan ciri bagian dari sesuatu. N1 topik, N2 bagian.",
      "contoh": [["ぞうは はなが ながいです。", "Gajah hidungnya panjang."], ["この ロボットは うでが ながいです。", "Robot ini lengannya panjang."]]
    },
    {
      "pola": "Keluhan: N が いたい / N が します",
      "arti": "… sakit / terasa …",
      "jelaskan": "あたまが いたい (sakit kepala), めまいが する (pusing), はきけが する (mual), さむけが する (menggigil), ねつが ある (demam), おなかが すく (lapar), のどが かわく (haus).",
      "contoh": [["あたまが いたいです。それに、さむけも します。", "Kepala sakit. Selain itu juga menggigil."], ["ねつが 三十八度 あります。", "Demam 38 derajat."]]
    },
    {
      "pola": "A は B より 〜",
      "arti": "A lebih … daripada B",
      "jelaskan": "より menandai pembanding.",
      "contoh": [["あたらしい ラインは ふるい ラインより はやいです。", "Line baru lebih cepat daripada line lama."]]
    },
    {
      "pola": "A は B ほど 〜ない",
      "arti": "A tidak se… B",
      "jelaskan": "ほど selalu dengan bentuk negatif.",
      "contoh": [["チカランは ジャカルタほど あつく ないです。", "Cikarang tidak sepanas Jakarta."]]
    },
    {
      "pola": "A と B と どちらが 〜ですか — A の ほうが 〜",
      "arti": "A dan B, mana yang lebih …? — A lebih …",
      "jelaskan": "Membandingkan dua hal. Kalau sama: どちらも 〜です. Kalau setara: A は B と おなじぐらい 〜.",
      "contoh": [["でんしゃと バスと どちらが はやいですか。", "Kereta dan bus mana yang lebih cepat?"], ["でんしゃの ほうが はやいです。", "Kereta lebih cepat."]]
    },
    {
      "pola": "N の 中で / Tempat で X が いちばん 〜",
      "arti": "di antara … / di … X yang paling …",
      "jelaskan": "Perbandingan tingkat tertinggi.",
      "contoh": [["この こうじょうで いちばん ふるい きかいは どれですか。", "Mesin paling tua di pabrik ini yang mana?"]]
    },
    {
      "pola": "V-た ほうが いいです / V-ない ほうが いいです",
      "arti": "sebaiknya V / sebaiknya jangan V",
      "jelaskan": "Memberi saran. Positif pakai bentuk た, negatif pakai bentuk ない.",
      "contoh": [["すぐ びょういんへ いった ほうが いいですよ。", "Sebaiknya segera ke rumah sakit."], ["むりを しない ほうが いいです。", "Sebaiknya jangan memaksakan diri."]]
    },
    {
      "pola": "N が いります / ひつようです",
      "arti": "perlu N",
      "jelaskan": "いる (要る) = perlu. Yang diperlukan ditandai が.",
      "contoh": [["日本へ いく とき、ビザが いります。", "Saat ke Jepang perlu visa."]]
    },
    {
      "pola": "〜し、〜し / それに",
      "arti": "… lagi pula …",
      "jelaskan": "Menderetkan beberapa alasan atau keadaan. Bentuk biasa + し.",
      "contoh": [["さむけも するし、はきけも します。", "Menggigil, mual pula."]]
    },
    {
      "pola": "〜のです / 〜んです",
      "arti": "(menjelaskan atau meminta penjelasan)",
      "jelaskan": "Menegaskan alasan atau menanyakan latar belakang. Sifat-な dan N: 〜なのです. Lisan: 〜んです.",
      "contoh": [["どうして やすむんですか。", "Kenapa tidak masuk?"], ["あたまが いたいんです。", "Soalnya kepala saya sakit."]]
    },
    {
      "pola": "Periode に Angka 回",
      "arti": "… kali per …",
      "jelaskan": "Frekuensi: いっしゅうかんに 二回 = dua kali seminggu.",
      "contoh": [["一日に 三回 くすりを のんで ください。", "Minum obat tiga kali sehari."]]
    }
