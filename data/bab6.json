  "bunpo": [
    {
      "pola": "Tempat に N が あります / います",
      "arti": "Di (tempat) ada N",
      "jelaskan": "あります untuk benda mati dan tumbuhan. います untuk orang dan hewan. Benda yang baru disebut ditandai が.",
      "contoh": [["つくえの 上に パソコンが あります。", "Di atas meja ada komputer."], ["こうじょうに ロボットが あります。", "Di pabrik ada robot."], ["へやに ブディさんが います。", "Di kamar ada Budi."]]
    },
    {
      "pola": "N は Tempat に あります / います",
      "arti": "N ada di (tempat)",
      "jelaskan": "Kalau bendanya sudah jadi topik, pakai は lalu sebut tempatnya. Tanya: N は どこに ありますか.",
      "contoh": [["かさは どこに ありますか。", "Payungnya di mana?"], ["ドアの そばに あります。", "Ada di dekat pintu."]]
    },
    {
      "pola": "N1 の うえ / した / なか / まえ / うしろ / よこ / あいだ",
      "arti": "atas / bawah / dalam / depan / belakang / samping / antara N1",
      "jelaskan": "Posisi selalu didahului N の. あいだ: N1 と N2 の あいだ = di antara N1 dan N2.",
      "contoh": [["ぎんこうと ゆうびんきょくの あいだに コンビニが あります。", "Di antara bank dan kantor pos ada minimarket."]]
    },
    {
      "pola": "N が Bilangan あります / います",
      "arti": "ada N sebanyak …",
      "jelaskan": "Bilangan diletakkan sebelum kata kerja, tanpa partikel. Kata bantu: 〜つ (benda umum), 〜まい (tipis), 〜ほん (panjang), 〜ひき (hewan kecil), 〜さつ (buku), 〜だい (mesin), 〜にん / ひとり・ふたり (orang).",
      "contoh": [["りんごが 三つ あります。", "Ada tiga apel."], ["ロボットが 二だい あります。", "Ada dua unit robot."], ["こどもが ふたり います。", "Ada dua anak."]]
    },
    {
      "pola": "なにか / だれか — なにも / だれも + negatif",
      "arti": "sesuatu / seseorang — tidak apa pun / tidak seorang pun",
      "jelaskan": "Pertanyaan pakai なにか / だれか. Jawaban 'tidak ada' pakai なにも / だれも + bentuk negatif. Partikel が / を hilang.",
      "contoh": [["へやに だれか いますか。", "Ada orang di kamar?"], ["いいえ、だれも いません。", "Tidak, tidak ada siapa pun."]]
    },
    {
      "pola": "Bilangan 1 + も + negatif",
      "arti": "satu pun tidak",
      "jelaskan": "ひとりも, いっぽんも, ひとつも + negatif = sama sekali tidak ada.",
      "contoh": [["お金が すこしも ありません。", "Uang sedikit pun tidak ada."], ["きゃくは ひとりも いません。", "Tidak ada satu pun pembeli."]]
    },
    {
      "pola": "Sifat-な + N / N は Sifat-な です",
      "arti": "N yang (sifat) / N itu (sifat)",
      "jelaskan": "Kata sifat-na diberi な sebelum kata benda, tapi な hilang di akhir kalimat. しずかな へや → へやは しずかです.",
      "contoh": [["しずかな こうえんです。", "Taman yang tenang."], ["この こうえんは しずかです。", "Taman ini tenang."]]
    },
    {
      "pola": "N を Bilangan ください",
      "arti": "Tolong berikan N sebanyak …",
      "jelaskan": "Pola utama saat berbelanja. Jumlah total: ぜんぶで いくらですか.",
      "contoh": [["この シャツを 二まい ください。", "Tolong kemeja ini dua lembar."], ["ぜんぶで いくらですか。", "Semuanya berapa?"]]
    },
    {
      "pola": "N だけ",
      "arti": "hanya N",
      "jelaskan": "だけ langsung setelah kata benda atau bilangan.",
      "contoh": [["しろい シャツだけですか。", "Hanya kemeja putih?"], ["コーヒーを 一ぱいだけ のみます。", "Saya minum kopi satu cangkir saja."]]
    }
  ],
